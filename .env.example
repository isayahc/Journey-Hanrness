MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=journey_harness
# stub is the only implemented provider. opencode deliberately fails until wired.
RESEARCH_PROVIDER=stub

# npm start manages the local OpenCode server and app together.
PORT=3000
APP_ORIGIN=http://localhost:3000
OPENCODE_URL=http://127.0.0.1:4096
# Defaults to OpenCode Space Bunny. Override with any provider/model ID you can access.
# Model availability and usage limits are controlled by OpenCode.
OPENCODE_MODEL=opencode/space-bunny-free
# Match the server password/username only if you set them when running opencode serve.
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# GitHub App user sign-in. Leave client ID/secret blank to keep local anonymous mode.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Add the slug to enable the authenticated "Connect GitHub repos" install flow.
# Configure the GitHub App setup URL as: ${APP_ORIGIN}/github/setup
# Configure OAuth callback URLs for:
#   ${APP_ORIGIN}/auth/github/callback
#   ${APP_ORIGIN}/github/setup/callback
GITHUB_APP_SLUG=

# Required for repository synchronization. The private key may be pasted with literal \n escapes.
# These secrets stay server-side and are used only to mint short-lived installation tokens.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Required for signed GitHub webhook reconciliation. Configure the GitHub App webhook URL as:
#   ${APP_ORIGIN}/webhooks/github
# Use application/json delivery content and the same high-entropy secret here and in GitHub.
GITHUB_APP_WEBHOOK_SECRET=

# Agent repository execution is opt-in because repository checks execute local project scripts.
# The OpenCode agent itself gets file tools and only a narrow read-only Git shell allowlist.
JOURNEY_AGENT_EXECUTION_ENABLED=0
# Optional. Defaults to the OS temp directory under journey-harness-agent-jobs.
JOURNEY_AGENT_WORKSPACE_ROOT=
